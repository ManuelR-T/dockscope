{
  "id": "official.kubernetes",
  "name": "Kubernetes",
  "version": "0.3.0",
  "manifestVersion": "1",
  "dockscopeApiVersion": "1",
  "hostApiVersion": "1",
  "description": "Adds Kubernetes graph, logs, delete, and HPA scale actions through the Kubernetes API.",
  "entry": "./plugin.mjs",
  "capabilities": [
    "source.graph",
    "source.logs",
    "action.lifecycle",
    "action.scale",
    "ui.settings"
  ],
  "permissions": ["kubernetes.api"],
  "execution": {
    "isolation": "process",
    "operationTimeoutMs": 30000,
    "maxStderrBytes": 64000,
    "memoryLimitMb": 128
  },
  "compatibility": {
    "minDockscopeVersion": "0.7.1"
  },
  "config": {
    "fields": [
      {
        "key": "KUBE_CONFIG",
        "label": "Kubeconfig path",
        "type": "string",
        "description": "Optional. Leave empty to use $KUBECONFIG or ~/.kube/config."
      }
    ]
  }
}
